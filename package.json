{
  "name": "@nine-at-a-time-media/skills",
  "version": "0.0.0",
  "description": "Canonical agent skills tree + MCP catalog (inert data, no binary). The version is stamped by CI at publish time; 0.0.0 is never published.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9atatimer/Skills.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "skills/",
    "mcp/",
    "pins.env",
    "SOURCE_STAMP"
  ],
  "scripts": {
    "build": "node scripts/stamp.mjs",
    "prepack": "node scripts/stamp.mjs",
    "test": "node --test 'test/*.test.mjs'"
  }
}
